NODE_ENV=development
PORT=5000

# Replace YOUR_POSTGRES_PASSWORD with the password chosen during PostgreSQL installation.
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/skill_exchange?schema=public"

# Replace this with a long random value before starting the server.
JWT_SECRET="replace-this-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN_SECONDS=604800

# Local folder for PDF uploads. Use persistent cloud storage for a permanent deployment.
UPLOAD_DIR="uploads/notes"
